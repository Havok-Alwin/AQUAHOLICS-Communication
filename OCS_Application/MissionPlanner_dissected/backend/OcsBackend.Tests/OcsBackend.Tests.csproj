<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the vehicle backend. No hardware, no SITL: MP talks to a fake serial port. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ocs.Backend.Tests</RootNamespace>
    <MpDir>$(MSBuildProjectDirectory)/..</MpDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- The backend project brings the MP runtime files; the tests also call MP types directly. -->
  <ItemGroup>
    <ProjectReference Include="../OcsBackend/OcsBackend.csproj" />
    <Reference Include="MissionPlanner.ArduPilot" HintPath="$(MpDir)/MissionPlanner.ArduPilot.dll" />
    <Reference Include="MissionPlanner.Comms" HintPath="$(MpDir)/MissionPlanner.Comms.dll" />
    <Reference Include="MissionPlanner.Utilities" HintPath="$(MpDir)/MissionPlanner.Utilities.dll" />
    <Reference Include="MAVLink" HintPath="$(MpDir)/MAVLink.dll" />
    <Reference Include="Interfaces" HintPath="$(MpDir)/Interfaces.dll" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
